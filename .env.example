# ======================= Core =======================
APP_ENV=production                      # development | production
DB_PATH=data/ugc_engine.db              # Docker sets /data/ugc_engine.db
LOG_LEVEL=INFO

# ======================= Dashboard =======================
DASHBOARD_PASSWORD=                     # REQUIRED in production, 12+ chars. Login user: admin
SECRET_KEY=                             # optional; derived from the password if blank
HOST=127.0.0.1
PORT=5000
COOKIE_SECURE=false                     # set true once served over HTTPS
TRUST_PROXY=false                       # set true behind nginx/Caddy/Traefik

# ======================= Discovery =======================
SERPER_API_KEY=                         # serper.dev: Google X-Ray (X, LinkedIn, TikTok, Notion, Forms)
APIFY_API_TOKEN=                        # apify.com: TikTok + Meta ad libraries
APIFY_ACTOR_TIKTOK=muhammadafzal/tiktok-ads-library-scraper   # verify on the Apify Store; blank disables
APIFY_ACTOR_META=data_ops_main/meta-ads                       # verify on the Apify Store; blank disables
APIFY_INPUT_TIKTOK={"searchMode": "keyword", "query": "{niche}", "maxResults": 25}
APIFY_INPUT_META={"searchQuery": "{niche}", "country": "US", "activeStatus": "active", "maxResults": 30}
APIFY_NICHES_PER_RUN=2
GEMINI_API_KEY=                         # qualifies leads, writes the sequence
GEMINI_MODEL=gemini-2.5-flash
HUNTER_API_KEY=                         # optional decision-maker email lookup
TARGET_NICHES=skincare,matcha,AI SaaS,fitness app,pet supplements
DISCOVERY_HOURS=6
MIN_SCORE_SAVE=50

# ======================= Your identity (appears in every email) =======================
SMTP_SENDER_NAME=Your Name
PORTFOLIO_URL=https://your-portfolio-link.com
SENDER_OFFER=an independent UGC creator who films native, vertical problem-solution video ads
SENDER_POSTAL_ADDRESS=                  # REQUIRED for live sending (commercial-email law, e.g. CAN-SPAM)

# ======================= Email transport (Gmail App Password) =======================
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# ======================= Outreach behaviour =======================
DRY_RUN=true                            # keep true until you've reviewed leads; false = real emails
DAILY_SEND_LIMIT=20
FOLLOWUP_DELAYS_DAYS=3,7                # step 2 after 3 days, step 3 after 7 more (day 10)
AUTO_SEND_FIRST=false                   # false = you approve every first email
AUTO_SEND_MIN_SCORE=75
SEND_WINDOW_UTC=08-18                   # automated sends only, Mon-Fri
SEND_JITTER_SECONDS=20-75               # random pause between automated sends
QUEUE_MINUTES=30
